# Supabase (leave blank to run on the local mock auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sentinel app URL used for public-health workspaces
VITE_SENTINEL_WORKSPACE_URL=http://127.0.0.1:5173/

# Telemedicine (optional)
# Public HTTPS address patients open video-visit links on; defaults to the address the clinician is using.
VITE_PUBLIC_APP_URL=
# TURN relay for patients on networks that block direct video (e.g. some mobile carriers / hospital firewalls).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Sentinel heatmap map tiles (optional locally). A CARTO basemaps key from https://carto.com/basemaps/apikey/
# counts tile use against your CARTO account; restrict it to your Sentinel domain in the CARTO dashboard.
VITE_CARTO_BASEMAPS_KEY=
