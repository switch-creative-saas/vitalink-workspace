{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vitalink-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5175",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5175,
      "url": "http://127.0.0.1:5175"
    },
    {
      "name": "vitalink-sentinel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "vitalink-sentinel",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "vitalink-web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 4174,
      "url": "http://127.0.0.1:4174"
    }
  ]
}
