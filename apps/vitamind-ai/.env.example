# Supabase project ynbdsrazaplzsrllfgym. The service role key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://ynbdsrazaplzsrllfgym.supabase.co
SUPABASE_SERVICE_KEY=

# Embeddings (text-embedding-3-small, 1536 dimensions)
OPENAI_API_KEY=

# Diagnosis model
ANTHROPIC_API_KEY=
VITAMIND_MODEL=claude-sonnet-4-6

# Long random string. Set the same value as the VITAMIND_SERVICE_TOKEN secret on the
# Supabase edge functions; requests without it are rejected.
VITAMIND_SERVICE_TOKEN=

# Spend protection (all optional; defaults shown). The service refuses paid calls once a daily
# budget is used (counted in public.ai_usage_daily from the usage the providers report) and
# caps its own request rate, independent of the edge function's per-user limits.
VITAMIND_MAX_TOKENS=2000
VITAMIND_MAX_REQUESTS_PER_MINUTE=30
VITAMIND_DAILY_LLM_REQUESTS=1500
VITAMIND_DAILY_LLM_TOKENS=3000000
VITAMIND_DAILY_EMBED_REQUESTS=5000
VITAMIND_DAILY_EMBED_TOKENS=5000000
# Consultation scribe (OpenAI speech-to-text) and its daily cap for the whole platform
VITAMIND_TRANSCRIBE_MODEL=gpt-4o-transcribe
VITAMIND_DAILY_AUDIO_MINUTES=1500
