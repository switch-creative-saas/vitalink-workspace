# Supabase project ynbdsrazaplzsrllfgym. The service role key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://ynbdsrazaplzsrllfgym.supabase.co
SUPABASE_SERVICE_KEY=

# Embeddings (text-embedding-3-small, 1536 dimensions)
OPENAI_API_KEY=

# Diagnosis model
ANTHROPIC_API_KEY=
VITAMIND_MODEL=claude-sonnet-4-6

# Long random string. Set the same value as the VITAMIND_SERVICE_TOKEN secret on the
